#!/bin/sh
set -e

case "$1" in
    remove)
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
        fi
        ;;
    purge)
        # Settings, state, credentials and master key. "remove" keeps them for a later reinstall.
        rm -rf /opt/flaresync/config
        rmdir /opt/flaresync 2>/dev/null || true
        ;;
esac

exit 0
